# Variables de entorno en Vercel (Settings → Environment Variables)
CRON_SECRET=            # cadena aleatoria larga; Vercel la envía sola a los crons
ANTHROPIC_API_KEY=      # clave de la API de Claude (búsqueda y lectura web)
ANTHROPIC_MODEL=claude-sonnet-4-5
GITHUB_TOKEN=           # token fine-grained con Contents y Pull requests: Read & write sobre devaro95/ProgramasClaros
GITHUB_REPO=devaro95/ProgramasClaros
GITHUB_BRANCH=main
PROGRAMS_MODE=pr        # pr = abre un PR para revisar cada programa · direct = publica sin revisión
PROGRAMS_MAX_PER_RUN=2
# Votación de los lectores (Upstash Redis desde Vercel Marketplace: crea estas dos solas)
KV_REST_API_URL=
KV_REST_API_TOKEN=
VOTE_SALT=              # cadena aleatoria larga; no la cambies una vez abierta la votación
